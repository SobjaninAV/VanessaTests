		Объем1 = Генератор.СлучайноеЧисло(1, 99999) / 1000;
		Объем2 = Генератор.СлучайноеЧисло(1, 99999) / 1000;
		Тоннаж1 = Генератор.СлучайноеЧисло(1, 99999) / 1000;
